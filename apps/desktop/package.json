{
  "name": "onebrowser-desktop",
  "version": "0.4.3",
  "description": "OneBrowser 桌面端（指纹环境 + 登录态云端共享）",
  "main": "out/main/index.mjs",
  "author": "OneBrowser",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "e2e": "electron-vite build && electron . --e2e",
    "e2e:run": "electron . --e2e",
    "e2e:teams": "electron-vite build && electron . --e2e-teams",
    "e2e:interop": "electron-vite build && electron . --e2e-interop",
    "kernel-smoke": "electron-vite build && electron . --kernel-smoke --docker",
    "e2e:fp": "electron-vite build && electron . --e2e-fp",
    "e2e:l2": "electron-vite build && electron . --e2e-l2",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist": "electron-vite build && electron-builder -mwl",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "element-plus": "^2.14.7",
    "vue": "^3.5.43",
    "ws": "^8.22.0"
  }
}