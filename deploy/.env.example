# ---- 必填 ----
DOMAIN=app.example.com            # 对外域名（A 记录指向本机；Caddy 自动签发证书）
POSTGRES_PASSWORD=change-me       # 数据库密码（强随机）
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# ---- 可选（默认值见 docker-compose.prod.yml / server config）----
# ACME_EMAIL=ops@example.com      # 证书到期通知邮箱
# S3_REGION=us-east-1
# S3_BUCKET=onebrowser-snapshots
# S3_USE_PATH_STYLE=false
# SNAPSHOT_RETENTION=5
# USER_QUOTA_GB=2
# AUTH_RATE_PER_MIN=20
# ADMIN_TOKEN=change-me           # 运维工作台口令（https://<DOMAIN>/admin/；留空=不开放）
